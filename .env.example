# Copia este archivo como ".env" (sin ".example") y completa tus datos reales.
# El archivo .env NUNCA debe subirse a Git (ya está en el .gitignore).
#
# Usa la MISMA cadena de conexión de Supabase que ya te compartió Jorge
# por el canal privado del equipo. NO la pegues en ningún chat ni la subas
# a ningún repositorio.

DATABASE_URL="postgresql://postgres.TU_USUARIO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Clave secreta para firmar los tokens de sesión (invéntate una larga y aleatoria)
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Almacenamiento de certificados de alumno regular (Supabase Storage, bucket PRIVADO "certificados").
# Si se dejan vacías, en desarrollo los archivos se guardan en la carpeta local "uploads/".
# En Vercel son OBLIGATORIAS (allí los archivos locales no se conservan).
# SUPABASE_SERVICE_ROLE_KEY da acceso total al proyecto: solo en el .env y en Vercel,
# nunca en el código, en un chat ni en el frontend.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
