venv/
env/

# Caché de Python (archivos compilados que se autogeneran y causan conflictos)
__pycache__/
*.pyc
*.pyo

# Archivos de sistema y configuración del editor (VS Code)
.vscode/
.DS_Store
Thumbs.db

# Certificados de alumno regular subidos en desarrollo (datos personales)
uploads/

