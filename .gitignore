# Lista de archivos y carpetas que Git no debe subir al repositorio.
# Sirve para no publicar información privada ni archivos que cada
# integrante genera en su propio computador.

# Archivos de entorno y credenciales (contraseñas y claves secretas)
.env

# Entorno virtual de Python (pesa mucho y cada integrante crea el suyo)
venv/
env/

# Caché de Python (archivos generados automáticamente)
__pycache__/
*.pyc
*.pyo

# Archivos subidos por los usuarios (por ejemplo, certificados de alumno regular).
# Se excluyen para que documentos personales no queden públicos en GitHub.
# Esta carpeta se utilizará cuando se implemente la subida de certificados.
uploads/

# Archivos de sistema y configuración del editor
.vscode/
.DS_Store
Thumbs.db
